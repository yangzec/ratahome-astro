---
import type { Locale } from '@trade/core/i18n/config';
import { getContent } from '../../lib/content';
import { localizedPath } from '@trade/core/i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const { common, navigation } = getContent(locale);
const { site, buttons } = common;
const ctaHash = `#${site.ctaAnchor ?? 'upload'}`;
---

<header class="sticky top-0 z-50 bg-izza-olive-dark text-white pt-[env(safe-area-inset-top,0px)]">
  <div class="hidden lg:block border-b border-white/10">
    <div class="container-site flex items-center justify-between py-2.5 text-sm gap-3 sm:gap-4">
      <p class="text-white/70 flex-1 min-w-0">{site.tagline}</p>
      <LanguageSwitcher locale={locale} currentPath={currentPath} />
      <a
        href={site.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-white/90 hover:text-white transition-colors shrink-0 min-w-0"
      >
        <span class="font-medium">WhatsApp {site.whatsapp}</span>
        <span class="text-white/50">{site.hours}</span>
      </a>
    </div>
  </div>

  <nav class="container-site hidden lg:block relative" aria-label="Main navigation">
    <div class="flex items-center justify-between py-5">
      <a href={localizedPath('/', locale)} class="flex items-center shrink-0">
        <img src="/images/logo.svg" alt={site.name} class="site-logo site-logo--on-dark" />
      </a>

      <div class="flex items-center gap-1">
        {navigation.main.map((item) => (
          <div class="group relative">
            <a
              href={item.href ? localizedPath(item.href, locale) : '#'}
              class="px-3 py-2 text-[15px] font-medium text-white/85 hover:text-white transition-colors"
            >
              {item.label}
            </a>
          </div>
        ))}
      </div>

      <a href={`${localizedPath('/', locale)}${ctaHash}`} class="btn-primary">
        {buttons.startProject}
      </a>
    </div>

    {navigation.main.filter((item) => item.groups || item.links).map((item) => (
      <div class="nav-panel absolute left-0 right-0 top-full opacity-0 invisible pointer-events-none transition-all duration-200">
        <div class="bg-white text-izza-ink shadow-2xl border-t border-izza-border/20">
          {item.groups ? (
            <div class={`container-site py-10 grid gap-8 ${item.feature ? 'grid-cols-4' : 'grid-cols-3'}`}>
              {item.groups.map((group) => (
                <div class="border-l border-izza-border/30 first:border-0 pl-8 first:pl-0">
                  <h3 class="eyebrow mb-5 flex items-center gap-3">
                    <span class="w-6 h-px bg-izza-accent"></span>
                    {group.title}
                  </h3>
                  <ul class="space-y-1">
                    {group.links.map((link) => (
                      <li>
                        <a href={localizedPath(link.href, locale)} class="block py-2.5 px-3 -mx-3 rounded-xl hover:bg-izza-cream transition-colors group/link">
                          <strong class="block text-[16px] font-semibold text-izza-ink group-hover/link:text-izza-accent">{link.label}</strong>
                          {link.description && <span class="text-sm text-izza-gray-muted">{link.description}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              {item.feature && (
                <a href={localizedPath(item.feature.href, locale)} class="relative rounded-[17px] overflow-hidden min-h-[280px] flex flex-col justify-end p-6 group/feat">
                  <img src={item.feature.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover/feat:scale-105" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
                  <div class="relative text-white">
                    <strong class="block text-lg font-semibold">{item.feature.title}</strong>
                    <span class="text-sm text-white/80">{item.feature.description}</span>
                  </div>
                </a>
              )}
            </div>
          ) : item.links ? (
            <div class="container-site py-8 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2">
              {item.links.map((link) => (
                <a href={localizedPath(link.href, locale)} class="block p-4 rounded-xl hover:bg-izza-cream transition-colors">
                  <strong class="block font-semibold text-izza-ink">{link.label}</strong>
                  {link.description && <span class="text-sm text-izza-gray-muted">{link.description}</span>}
                </a>
              ))}
            </div>
          ) : null}
        </div>
      </div>
    ))}
  </nav>

  <div class="container-site mobile-header-bar flex lg:hidden items-center justify-between gap-3 border-b border-white/10">
    <a href={localizedPath('/', locale)} class="flex items-center shrink-0 min-w-0">
      <img src="/images/logo.svg" alt={site.name} class="site-logo site-logo--on-dark" />
    </a>
    <button id="mobile-menu-btn" type="button" class="p-2 -mr-2 text-white" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>

<div id="mobile-menu" class="hidden fixed inset-0 z-[60] bg-white flex flex-col pt-[env(safe-area-inset-top,0px)]">
  <div class="container-site mobile-header-bar flex items-center justify-between gap-3 border-b border-izza-border/30 shrink-0">
    <a href={localizedPath('/', locale)} class="flex items-center shrink-0 min-w-0">
      <img src="/images/logo.svg" alt={site.name} class="site-logo" />
    </a>
    <button id="mobile-menu-close" type="button" class="p-2 -mr-2 text-izza-ink" aria-label="Close menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <nav class="flex-1 overflow-y-auto container-site py-4" aria-label="Mobile navigation">
    {navigation.main.map((item) => (
      <div class="border-b border-izza-border/20">
        <button type="button" data-accordion class="w-full flex items-center justify-between py-4 text-left font-semibold text-izza-ink">
          {item.label}
          <svg data-chevron class="w-5 h-5 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="hidden pb-4 pl-2 space-y-2">
          {item.href && <a href={localizedPath(item.href, locale)} class="block py-2 text-izza-accent font-medium">{buttons.viewAll}</a>}
          {(item.groups || []).flatMap((g) => g.links).concat(item.links || []).map((link) => (
            <a href={localizedPath(link.href, locale)} class="block py-2 text-izza-gray-text hover:text-izza-accent">{link.label}</a>
          ))}
        </div>
      </div>
    ))}

    <div class="mt-6 pt-6 border-t border-izza-border/20 space-y-4">
      <div class="flex items-center justify-between gap-4">
        <LanguageSwitcher locale={locale} currentPath={currentPath} variant="on-light" />
        <a
          href={site.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-izza-accent hover:underline shrink-0"
        >
          WhatsApp
        </a>
      </div>
      <a href={`${localizedPath('/', locale)}#upload`} class="btn-primary btn-block">{buttons.startProject}</a>
    </div>
  </nav>
</div>

<style>
  nav .group:hover .nav-panel,
  .nav-panel:hover {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
</style>
