---
import type { Locale } from '@trade/core/i18n/config';
import { getContent } from '../../lib/content';
import { localizedPath } from '@trade/core/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { common, home, navigation } = getContent(locale);
const { site, footer } = common;
---

<footer class="bg-izza-olive-dark text-white">
  <div class="container-site footer-y">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 section-header">
      {home.footerFeatures.map((feature) => (
        <div>
          <h3 class="font-semibold text-white mb-2">{feature.title}</h3>
          <p class="text-sm text-white/60">{feature.description}</p>
        </div>
      ))}
    </div>

    <div class="border-t border-white/10 footer-divider grid md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      <div class="lg:col-span-1">
        <img src="/images/logo.svg" alt={site.name} class="site-logo brightness-0 invert mb-4" />
        <p class="text-sm text-white/60 leading-relaxed">{footer.description}</p>
      </div>

      {navigation.main.slice(0, 3).map((section) => (
        <div>
          <h4 class="font-semibold text-white mb-4 text-sm uppercase tracking-wider">{section.label}</h4>
          <ul class="space-y-2">
            {(section.groups?.flatMap((g) => g.links) || section.links || []).slice(0, 5).map((link) => (
              <li>
                <a href={localizedPath(link.href, locale)} class="text-sm text-white/60 hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="border-t border-white/10 footer-divider flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-white/50">
      <p>&copy; {new Date().getFullYear()} {site.name}. {footer.copyright}</p>
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-6 text-center sm:text-left">
        <span>{site.location}</span>
        <span>{site.hours}</span>
        <a href={site.whatsappUrl} class="hover:text-white transition-colors">WhatsApp</a>
      </div>
    </div>
  </div>
</footer>
