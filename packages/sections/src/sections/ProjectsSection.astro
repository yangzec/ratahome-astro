---
import type { Locale } from '@trade/core/i18n/config';
import { getContent } from '@site/content';
import { localizedPath } from '@trade/core/i18n/utils';
import Button from '../ui/Button.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home, common } = getContent(locale);
const { projects } = home;
---

<section class="container-site py-12 md:py-20">
  <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-12">
    <h2 class="section-title">{projects.title}</h2>
    <Button href={localizedPath('/projects', locale)} variant="secondary">{common.buttons.exploreProjects}</Button>
  </div>
  <div class="grid md:grid-cols-2 gap-8">
    {projects.items.map((project) => (
      <a href={localizedPath(project.href, locale)} class="group block">
        <div class="relative rounded-[25px] overflow-hidden aspect-[16/10] mb-6">
          <img src={project.image} alt={project.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute top-4 left-4 flex flex-wrap gap-2">
            <span class="px-3 py-1 rounded-full bg-white/90 text-xs font-medium text-izza-ink">{project.location}</span>
            <span class="px-3 py-1 rounded-full bg-white/90 text-xs font-medium text-izza-ink">{project.delivery}</span>
          </div>
        </div>
        <p class="eyebrow text-xs mb-2">{project.type}</p>
        <h3 class="text-2xl font-semibold text-izza-ink mb-2 group-hover:text-izza-accent transition-colors">{project.title}</h3>
        <p class="text-sm text-izza-gray-muted">Scope: {project.scope} · Solution: {project.solution}</p>
      </a>
    ))}
  </div>
</section>
