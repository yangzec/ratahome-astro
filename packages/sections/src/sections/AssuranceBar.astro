---
import type { Locale } from '@trade/core/i18n/config';
import { getContent } from '@site/content';
import FeatureIcon from '../ui/FeatureIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home } = getContent(locale);
---

<section class="bg-izza-cream border-y border-izza-border/30">
  <div class="container-site section-y-sm grid grid-cols-2 lg:grid-cols-4 gap-x-3 gap-y-4 sm:gap-x-4 sm:gap-y-5">
    {home.assurances.map((item) => (
      <div class="flex gap-2.5 items-start min-w-0">
        <FeatureIcon src={item.icon} class="mt-0.5" />
        <div class="min-w-0">
          <strong class="block text-izza-ink font-semibold text-sm leading-snug mb-1">{item.title}</strong>
          <span class="block text-xs sm:text-sm text-izza-gray-muted leading-snug">{item.description}</span>
        </div>
      </div>
    ))}
  </div>
</section>
