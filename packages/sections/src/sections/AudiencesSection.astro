---
import type { Locale } from '@trade/core/i18n/config';
import { getContent } from '@site/content';
import { localizedPath } from '@trade/core/i18n/utils';
import SectionHeader from '../ui/SectionHeader.astro';
import ListGrid from '../ui/ListGrid.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home } = getContent(locale);
const { audiences } = home;
const items = Array.isArray(audiences?.items) ? audiences.items : [];
---

{items.length > 0 && (
<section class="container-site py-20">
  <SectionHeader title={audiences.title} description={audiences.description} />
  <ListGrid min={240} count={items.length}>
    {items.map((item) => (
      <a href={localizedPath(item.href, locale)} class="group block">
        <div class="relative rounded-[20px] overflow-hidden aspect-[3/4] mb-5">
          <img src={item.image} alt={item.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <h3 class="text-white text-xl font-semibold">{item.title}</h3>
          </div>
        </div>
        <p class="text-izza-gray-text">{item.description}</p>
      </a>
    ))}
  </ListGrid>
</section>
)}
