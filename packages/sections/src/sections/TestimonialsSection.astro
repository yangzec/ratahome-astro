---
import type { Locale } from '@trade/core/i18n/config';
import { getContent } from '@site/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home } = getContent(locale);
---

<section class="bg-izza-olive-dark py-20">
  <div class="container-site grid md:grid-cols-2 gap-8">
    {home.testimonials.map((t) => (
      <blockquote class="p-8 rounded-[20px] bg-white/5 border border-white/10">
        <p class="text-white text-lg leading-relaxed mb-6">&ldquo;{t.quote}&rdquo;</p>
        <cite class="text-white/60 text-sm not-italic">{t.author}</cite>
      </blockquote>
    ))}
  </div>
</section>
