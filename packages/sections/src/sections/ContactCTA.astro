---
import type { Locale } from '@trade/core/i18n/config';
import { getContent } from '@site/content';
import ContactForm from '../forms/ContactForm.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home, common } = getContent(locale);
const { cta } = home;
const { site, buttons } = common;
---

<section id="upload" class="container-site py-12">
  <div class="grid lg:grid-cols-2 gap-8 items-start">
    <div>
      <h2 class="section-title mb-4">{cta.title}</h2>
      <p class="text-izza-gray-text text-lg mb-6">{cta.description}</p>
      <ol class="space-y-3 mb-6">
        {cta.steps.map((step, i) => (
          <li class="flex gap-4">
            <span class="eyebrow text-xs shrink-0">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-izza-gray-text">{step}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="inquiry-card">
      <ContactForm locale={locale} />
      <div class="mt-6 text-center">
        <a href={site.whatsappUrl} target="_blank" rel="noopener" class="text-izza-accent font-medium hover:underline">{buttons.whatsappUs}</a>
      </div>
    </div>
  </div>
</section>
