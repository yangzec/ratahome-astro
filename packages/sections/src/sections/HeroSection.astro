---
import type { Locale } from '@trade/core/i18n/config';
import { getContent } from '@site/content';
import { localizedPath } from '@trade/core/i18n/utils';
import Button from '../ui/Button.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home, common } = getContent(locale);
const { hero } = home;
const { buttons } = common;
const primaryHref = 'primaryHref' in hero && typeof hero.primaryHref === 'string' ? hero.primaryHref : '#upload';
const secondaryHref = 'secondaryHref' in hero && typeof hero.secondaryHref === 'string' ? hero.secondaryHref : '/foshan-sourcing-tour';
---

<section class="site-hero">
  <img src={hero.image} alt={hero.imageAlt} class="site-hero-media" />
  <div class="site-hero-shade"></div>
  <div class="site-hero-copy container-site">
    <p class="eyebrow site-hero-kicker">{hero.eyebrow}</p>
    <h1 class="site-hero-title">{hero.title}</h1>
    <p class="site-hero-desc">{hero.description}</p>
    <div class="site-hero-actions">
      <Button href={primaryHref} variant="primary">{buttons.uploadFloorPlan}</Button>
      <Button href={localizedPath(secondaryHref, locale)} variant="outline">{buttons.factoryTour}</Button>
    </div>
  </div>
</section>

<style>
  /* 必须用 column + 全宽文案层。行 flex 会把中文收成单字竖条（min-content）。 */
  .site-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: 32rem;
    overflow: hidden;
  }

  .site-hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .site-hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14, 20, 28, 0.72) 0%, rgba(14, 20, 28, 0.34) 46%, rgba(14, 20, 28, 0.18) 100%);
  }

  .site-hero-copy {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    padding-top: 2.5rem;
    padding-bottom: 2rem;
  }

  .site-hero-kicker {
    margin: 0 0 1rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .site-hero-title {
    max-width: 40rem;
    margin: 0 0 1rem;
    color: #fff;
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.2;
    overflow-wrap: break-word;
  }

  .site-hero-desc {
    max-width: 36em;
    margin: 0 0 1.5rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1rem;
    line-height: 1.6;
  }

  :global(html[lang='en']) .site-hero-desc {
    max-width: 65ch;
  }

  .site-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .site-hero {
      min-height: 36rem;
    }

    .site-hero-copy {
      padding-top: 3rem;
      padding-bottom: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .site-hero {
      min-height: calc(100svh - var(--header-h, 6.5rem));
      justify-content: center;
    }

    .site-hero-copy {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
  }
</style>
