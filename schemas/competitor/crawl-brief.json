{
  "schemaVersion": 1,
  "owner": "user-jina-or-cloudflare",
  "repoDoesNotCrawl": true,
  "description": "Two-pass fetch. Pass 1 is only homepage + sitemap + robots. Pass 2 URLs are classified from that dump — do not assume /about or /products.",
  "docs": {
    "jinaReader": "https://r.jina.ai/docs",
    "jinaProduct": "https://jina.ai/en-US/reader/",
    "cfCrawl": "https://developers.cloudflare.com/browser-run/quick-actions/crawl-endpoint/",
    "cfMarkdown": "https://developers.cloudflare.com/browser-run/quick-actions/markdown-endpoint/"
  },
  "quota": {
    "competitorsPerIndustry": 3,
    "pagesPerCompetitor": 6,
    "maxPagesHardCap": 12,
    "productSamples": "1-2",
    "blogPosts": 0,
    "legalBody": false
  },
  "pass1": {
    "fetch": ["/", "/sitemap.xml", "/robots.txt"],
    "alsoIfPresent": ["/sitemap_index.xml", "/sitemap-index.xml"],
    "purpose": "Discover this site's real nav and URL patterns. Paths differ per site."
  },
  "pass2": {
    "classifier": "schemas/competitor/classify-seeds.mjs",
    "command": "node schemas/competitor/classify-seeds.mjs --origin {origin} --home raw/home.md --sitemap raw/sitemap.xml --out raw/seeds.json",
    "select": [
      { "pageType": "home", "required": true },
      { "pageType": "about", "required": true },
      { "pageType": "category", "required": true },
      { "pageType": "product", "required": true, "limit": 2 },
      { "pageType": "contact", "required": true },
      { "pageType": "case", "required": true, "alternateOf": ["faq"] }
    ],
    "ifUnresolved": "Fetch one more nav page that looks closest, or skip that type and record it in seeds.json#/unresolved"
  },
  "pageTypeHints": {
    "about": ["about", "company", "our-story", "who-we-are", "关于", "公司"],
    "contact": ["contact", "enquiry", "inquire", "enquire", "quote", "联系", "询盘", "报价"],
    "category": ["products", "collections", "shop", "solutions", "产品", "系列"],
    "case": ["projects", "portfolio", "works", "cases", "案例"],
    "faq": ["faq", "help", "常见问题"]
  },
  "exclude": {
    "paths": [
      "/blog/**",
      "/news/**",
      "/insights/**",
      "/cart/**",
      "/account/**",
      "/login/**",
      "/wp-admin/**",
      "/search/**",
      "/tag/**",
      "/privacy",
      "/terms",
      "/cookie"
    ],
    "content": [
      "login-gated pages",
      "full SKU catalog",
      "all product images at original resolution",
      "CSS/JS source",
      "third-party pixels",
      "legal page bodies"
    ]
  },
  "perPageExtract": {
    "always": ["finalUrl", "httpStatus", "title", "description", "h1", "markdown", "imageUrls", "outboundLinks"],
    "homeAlso": ["nav labels+hrefs", "hero copy", "section heading order"],
    "contactAlso": ["form field names/types/required", "CTA labels", "whatsapp/email/phone if public"],
    "categoryAlso": ["category cards: label, href, image"],
    "productAlso": ["visible specs", "1 main image + 1 lifestyle if present"]
  },
  "notExpectedFromCrawler": [
    "theme-tokens.json (needs computed CSS; fill later from screenshot or DevTools)",
    "sections/*.json role mapping (fill after markdown lands)",
    "license judgements beyond default reference-only"
  ],
  "jina": {
    "method": "GET",
    "url": "https://r.jina.ai/{absoluteUrl}",
    "headers": {
      "Authorization": "Bearer {JINA_TOKEN}",
      "Accept": "application/json",
      "X-Respond-With": "frontmatter",
      "X-Retain-Images": "all",
      "X-Retain-Links": "all",
      "X-Retain-Media": "link",
      "X-With-Images-Summary": "true",
      "X-With-links-Summary": "true",
      "X-Robots-Txt": "true",
      "X-Engine": "browser",
      "X-Timeout": "60",
      "X-Locale": "{locale}"
    },
    "notes": [
      "Official options: https://r.jina.ai/docs",
      "Pass 1: only homepage. Keep X-With-links-Summary so classify-seeds can read the nav.",
      "Pass 2: fetch only URLs listed in raw/seeds.json.",
      "Do not use X-Preset: spider.",
      "X-With-Generated-Alt does not work when X-Respond-With is set; skip it."
    ]
  },
  "cloudflare": {
    "pass1Markdown": {
      "method": "POST",
      "url": "https://api.cloudflare.com/client/v4/accounts/{account_id}/browser-rendering/markdown",
      "body": {
        "url": "{origin}/",
        "gotoOptions": { "waitUntil": "networkidle0" }
      },
      "useWhen": "Homepage only. Also download /sitemap.xml and /robots.txt as plain HTTP."
    },
    "pass2Markdown": {
      "method": "POST",
      "url": "https://api.cloudflare.com/client/v4/accounts/{account_id}/browser-rendering/markdown",
      "body": {
        "url": "{seedUrl}",
        "gotoOptions": { "waitUntil": "networkidle0" }
      },
      "useWhen": "Each classified seed in raw/seeds.json. Do not pre-bake /about or /products into includePatterns."
    },
    "wideCrawlDiscouraged": {
      "reason": "Site IA varies. A wide /crawl with hardcoded includePatterns misses /our-story and /enquire-now.",
      "ifUsedAnyway": {
        "limit": 12,
        "depth": 2,
        "formats": ["markdown"],
        "render": true,
        "crawlPurposes": ["ai-input"],
        "contentUse": "reference",
        "includePatterns": "Generate from seeds.json after pass 1, never from a fixed path list"
      }
    },
    "notes": [
      "Official crawl: https://developers.cloudflare.com/browser-run/quick-actions/crawl-endpoint/",
      "Official markdown: https://developers.cloudflare.com/browser-run/quick-actions/markdown-endpoint/",
      "Token needs Browser Rendering - Edit.",
      "If robots.txt Content-Signal rejects ai-input/reference, skip that host; do not bypass."
    ]
  },
  "drop": {
    "root": ".tmp/competitor-intel/{industry}/{domain}/",
    "pass1": [
      "raw/home.md",
      "raw/home.jina.json",
      "raw/sitemap.xml",
      "raw/robots.txt"
    ],
    "pass2": [
      "raw/seeds.json",
      "raw/pages/{pageType}-{slug}.md"
    ],
    "afterNormalize": [
      "collection.json",
      "meta.json",
      "ia.json",
      "pages/{pageType}/{slug}.md",
      "images/manifest.json"
    ],
    "fillLater": [
      "sections/home.json",
      "forms/contact.json",
      "theme-tokens.json",
      "products.json"
    ]
  }
}
