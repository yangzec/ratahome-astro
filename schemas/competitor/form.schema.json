{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratahome.local/schemas/competitor/form.schema.json",
  "title": "Competitor conversion form",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceUrl", "intent", "fields", "ctas"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "sourceUrl": { "type": "string" },
    "locale": { "type": "string" },
    "intent": {
      "type": "string",
      "enum": ["quote", "sample", "prototype", "floor-plan", "oem", "general"]
    },
    "formTitle": { "type": "string" },
    "formDescription": { "type": "string" },
    "privacy": { "type": "string" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "label": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "email",
              "tel",
              "textarea",
              "select",
              "file",
              "number",
              "hidden",
              "checkbox"
            ]
          },
          "required": { "type": "boolean" },
          "placeholder": { "type": "string" },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "label"],
              "properties": {
                "value": { "type": "string" },
                "label": { "type": "string" }
              }
            }
          },
          "accept": { "type": "string" },
          "mapsTo": {
            "type": "string",
            "description": "common.json JSON pointer, e.g. /form/name"
          }
        }
      }
    },
    "ctas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "label": { "type": "string" },
          "href": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["submit", "whatsapp", "email", "phone", "secondary"]
          },
          "mapsTo": { "type": "string" }
        }
      }
    }
  }
}
