---
import type { Locale } from '@trade/core/i18n/config';
import { getContent } from '../../lib/content';
import { localizedPath } from '@trade/core/i18n/utils';
import SectionHeader from '@trade/sections/ui/SectionHeader.astro';
import Button from '@trade/sections/ui/Button.astro';
import ListGrid from '@trade/sections/ui/ListGrid.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home, common } = getContent(locale);
const { warranty } = home;
const cases = Array.isArray(warranty?.cases) ? warranty.cases : [];
---

{cases.length > 0 && (
<section class="container-site py-20">
  <SectionHeader title={warranty.title} description={warranty.description} eyebrow={warranty.eyebrow} />
  <ListGrid min={260} count={cases.length} class="mt-10">
    {cases.map((case_) => (
      <div class="p-8 rounded-[20px] bg-izza-cream">
        <p class="eyebrow text-xs mb-4">{case_.question}</p>
        <h3 class="text-xl font-semibold text-izza-ink mb-3">{case_.title}</h3>
        <p class="text-sm text-izza-gray-muted leading-relaxed">{case_.description}</p>
      </div>
    ))}
  </ListGrid>
  <div class="mt-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-8 rounded-[20px] border border-izza-border/50">
    <p class="text-izza-gray-text max-w-xl">{warranty.commitment}</p>
    <Button href={localizedPath('/cases', locale)} variant="secondary" class="shrink-0">{common.buttons.readWarranty}</Button>
  </div>
</section>
)}
