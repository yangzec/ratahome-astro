---
import type { Locale } from '@trade/core/i18n/config';
import { getContent } from '../../lib/content';
import SectionHeader from '@trade/sections/ui/SectionHeader.astro';
import ListGrid from '@trade/sections/ui/ListGrid.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home } = getContent(locale);
const { ecosystem } = home;
const items = Array.isArray(ecosystem?.items) ? ecosystem.items : [];
---

{items.length > 0 && (
<section class="bg-izza-olive-dark text-white py-20">
  <div class="container-site">
    <SectionHeader title={ecosystem.title} description={ecosystem.description} dark />
    <ListGrid min={240} count={items.length} class="mt-10">
      {items.map((item) => (
        <div class="p-6 rounded-[17px] border border-white/10">
          {'step' in item && item.step ? (
            <span class="text-izza-accent font-semibold text-sm mb-3 block">{item.step}</span>
          ) : null}
          <h3 class="text-lg font-semibold text-white mb-2">{item.title}</h3>
          <p class="text-sm text-white/60">{item.description}</p>
        </div>
      ))}
    </ListGrid>
  </div>
</section>
)}
