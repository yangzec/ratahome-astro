---
import '../styles/global.css';
import type { Locale } from '@trade/core/i18n/config';
import { getContent } from '../lib/content';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import theme from '@site/theme';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const { common } = getContent(locale);
const { site } = common;

const pageTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} — ${site.title}`;
const pageDescription = description ?? site.description;
const currentPath = Astro.url.pathname;

const c = theme.colors;
const f = theme.fonts;
const r = theme.radius;

const themeVars = `:root {
  --color-izza-accent: rgb(${c.accent});
  --color-izza-ink: rgb(${c.ink});
  --color-izza-charcoal: rgb(${c.charcoal});
  --color-izza-gray-text: rgb(${c.grayText});
  --color-izza-gray-muted: rgb(${c.grayMuted});
  --color-izza-cream: rgb(${c.cream});
  --color-izza-cream-deep: rgb(${c.creamDeep});
  --color-izza-stone: rgb(${c.stone});
  --color-izza-border: rgb(${c.border});
  --color-izza-olive: rgb(${c.olive});
  --color-izza-olive-dark: rgb(${c.oliveDark});
  --color-izza-chrome: rgb(${c.chrome});
  --font-sans: ${f.sans};
  --font-label: ${f.label};
  --font-display: ${f.display};
  --radius-hero: ${r.hero};
  --radius-image: ${r.image};
  --radius-step: ${r.step};
  --radius-pill: ${r.pill};
}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <title>{pageTitle}</title>
    <style is:global set:html={themeVars}></style>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header locale={locale} currentPath={currentPath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <a
      id="wa-fab"
      href={site.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={common.buttons.whatsappUs}
      class="fixed z-30 flex h-14 w-14 items-center justify-center rounded-full bg-izza-accent text-white shadow-lg hover:opacity-90"
      style="bottom: max(1.5rem, env(safe-area-inset-bottom, 0px)); right: max(1.5rem, env(safe-area-inset-right, 0px));"
    >
      <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.48-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.12 3.24 5.14 4.54.72.31 1.28.5 1.72.64.72.23 1.38.2 1.9.12.58-.09 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" />
        <path d="M12.04 2C6.58 2 2.15 6.42 2.15 11.88c0 1.75.46 3.45 1.34 4.95L2 22l5.3-1.39a9.86 9.86 0 0 0 4.74 1.21h.01c5.46 0 9.89-4.42 9.89-9.88C22 6.42 17.5 2 12.04 2Zm0 18.06h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.15.82.84-3.07-.2-.32a8.18 8.18 0 0 1-1.26-4.38c0-4.53 3.7-8.21 8.25-8.21 2.2 0 4.27.86 5.83 2.41a8.16 8.16 0 0 1 2.42 5.81c0 4.53-3.7 8.21-8.24 8.21Z" />
      </svg>
    </a>
    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const closeBtn = document.getElementById('mobile-menu-close');

      menuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      });

      closeBtn?.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
        document.body.style.overflow = '';
      });

      document.querySelectorAll('[data-accordion]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const panel = btn.nextElementSibling;
          const icon = btn.querySelector('[data-chevron]');
          panel?.classList.toggle('hidden');
          icon?.classList.toggle('rotate-180');
        });
      });

      const waFab = document.getElementById('wa-fab');
      const toggleWaFab = (hidden: boolean) => {
        if (!waFab) return;
        waFab.classList.toggle('opacity-0', hidden);
        waFab.classList.toggle('pointer-events-none', hidden);
        waFab.setAttribute('aria-hidden', hidden ? 'true' : 'false');
      };
      document.querySelectorAll('form.contact-form input, form.contact-form textarea, form.contact-form select').forEach((field) => {
        field.addEventListener('focus', () => toggleWaFab(true));
        field.addEventListener('blur', () => toggleWaFab(false));
      });
    </script>
  </body>
</html>
