---
import type { Locale } from '@trade/core/i18n/config';
import Header from '@trade/sections/layout/Header.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
---

<Header
  locale={locale}
  currentPath={currentPath}
  logoSrc="/images/logo.png"
  showSiteName
  utility="tagline"
  ctaHref="#upload"
/>
