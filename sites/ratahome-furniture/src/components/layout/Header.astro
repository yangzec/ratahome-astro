---
import type { Locale } from '@trade/core/i18n/config';
import { getContent } from '../../lib/content';
import { localizedPath } from '@trade/core/i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const { common, navigation } = getContent(locale);
const { site, buttons } = common;
---

<header class="sticky top-0 z-50 bg-izza-olive-dark text-white">
  <div class="border-b border-white/10">
    <div class="container-site flex items-center justify-between py-2.5 text-sm gap-4">
      <p class="hidden lg:block text-white/70 flex-1">{site.tagline}</p>
      <LanguageSwitcher locale={locale} currentPath={currentPath} />
      <a
        href={site.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-white/90 hover:text-white transition-colors shrink-0"
      >
        <span class="font-medium">WhatsApp {site.whatsapp}</span>
        <span class="hidden md:inline text-white/50">{site.hours}</span>
      </a>
    </div>
  </div>

  <nav class="container-site hidden lg:block relative" aria-label="Main navigation">
    <div class="flex items-center justify-between py-5">
      <a href={localizedPath('/', locale)} class="flex items-center gap-3">
        <img src="/images/logo.png" alt={site.name} class="h-8 w-auto brightness-0 invert" />
        <span class="font-display text-xl tracking-widest text-white">{site.name}</span>
      </a>

      <div class="flex items-center gap-1">
        {navigation.main.map((item) => (
          <div class="group relative">
            <a
              href={item.href ? localizedPath(item.href, locale) : '#'}
              class="px-3 py-2 text-[15px] font-medium text-white/85 hover:text-white transition-colors"
            >
              {item.label}
            </a>
          </div>
        ))}
      </div>

      <a href={`${localizedPath('/', locale)}#upload`} class="btn-primary !min-h-11 !text-sm !px-6">
        {buttons.startProject}
      </a>
    </div>
  </nav>

  <div class="container-site flex lg:hidden items-center justify-between py-4">
    <a href={localizedPath('/', locale)} class="flex items-center gap-2">
      <img src="/images/logo.png" alt={site.name} class="h-7 w-auto brightness-0 invert" />
      <span class="font-display text-lg tracking-widest text-white">{site.name}</span>
    </a>
    <button id="mobile-menu-btn" class="p-2 text-white" aria-label="Open menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>
