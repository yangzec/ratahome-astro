---
import { locales, localeLabels, type Locale } from '@trade/core/i18n/config';
import { switchLocalePath } from '@trade/core/i18n/utils';

interface Props {
  locale: Locale;
  currentPath: string;
  variant?: 'on-dark' | 'on-light';
}

const { locale, currentPath, variant = 'on-dark' } = Astro.props;
const onLight = variant === 'on-light';
---

<div class="flex items-center gap-1 text-sm">
  {locales.map((loc) => (
    <a
      href={switchLocalePath(currentPath, loc)}
      class={`px-2 py-1 rounded transition-colors ${
        loc === locale
          ? 'text-izza-accent font-semibold'
          : onLight
            ? 'text-izza-gray-muted hover:text-izza-ink'
            : 'text-white/60 hover:text-white'
      }`}
      hreflang={loc}
    >
      {loc === 'en' ? 'EN' : '中文'}
    </a>
  ))}
</div>
