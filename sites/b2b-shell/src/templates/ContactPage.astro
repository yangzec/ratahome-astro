---
import type { Locale } from '@trade/core/i18n/config';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '@trade/sections/ui/PageHero.astro';
import ContactForm from '@trade/sections/forms/ContactForm.astro';
import { getContent } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { pages, common } = getContent(locale);
const contact = pages.contact;
const { site } = common;
---

<BaseLayout locale={locale} title={contact.title} description={contact.heroDescription}>
  <PageHero title={contact.heroTitle} dark />

  <section class="container-site py-12">
    <div class="grid lg:grid-cols-2 gap-8">
      <div>
        <h2 class="section-title mb-6">{contact.getInTouch}</h2>
        <div class="space-y-6">
          <div>
            <h3 class="font-semibold text-izza-ink mb-1">{locale === 'zh' ? '地址' : 'Address'}</h3>
            <p class="text-izza-gray-text">{site.address ?? site.location}</p>
          </div>
          <div>
            <h3 class="font-semibold text-izza-ink mb-1">{locale === 'zh' ? '电话' : 'Phone'}</h3>
            <a href={`tel:${site.phone?.replace(/\s/g, '')}`} class="text-izza-accent hover:underline">{site.phone}</a>
          </div>
          <div>
            <h3 class="font-semibold text-izza-ink mb-1">WhatsApp</h3>
            <a href={site.whatsappUrl} class="text-izza-accent hover:underline">{site.whatsapp}</a>
            <p class="text-sm text-izza-gray-muted">{site.hours}</p>
          </div>
          <div>
            <h3 class="font-semibold text-izza-ink mb-1">{locale === 'zh' ? '邮箱' : 'Email'}</h3>
            <a href={`mailto:${site.email}`} class="text-izza-accent hover:underline">{site.email}</a>
          </div>
        </div>
        <p class="text-sm text-izza-gray-muted mt-8">{contact.whatsappLine}</p>
        {contact.visitNote && <p class="text-sm text-izza-gray-muted mt-4">{contact.visitNote}</p>}
      </div>
      <div class="inquiry-card">
        <ContactForm locale={locale} />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const intent = params.get('intent');
  const select = document.querySelector<HTMLSelectElement>('select[name="projectType"]');
  if (select && intent === 'quote') select.value = 'residence';
  if (select && intent === 'sample') select.value = 'design';
</script>
