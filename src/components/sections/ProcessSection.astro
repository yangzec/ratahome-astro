---
import type { Locale } from '../../i18n/config';
import { getContent } from '../../lib/content';
import { localizedPath } from '../../i18n/utils';
import Button from '../ui/Button.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home, common } = getContent(locale);
const { process } = home;
---

<section class="container-site py-20">
  <div class="grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <h2 class="section-title mb-4">{process.title}</h2>
      <p class="text-izza-gray-text text-lg mb-8">{process.description}</p>
      <Button href={localizedPath('/how-it-works', locale)} variant="secondary">{common.buttons.seeJourney}</Button>
    </div>
    <div class="relative rounded-[25px] overflow-hidden aspect-[4/3]">
      <img src={process.image} alt={process.imageAlt} class="w-full h-full object-cover" />
    </div>
  </div>
  <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4 mt-12">
    {process.steps.map((step) => (
      <div class="p-6 rounded-[17px] border border-izza-border/50 hover:border-izza-accent/30 transition-colors">
        <span class="eyebrow text-xs mb-3 block">{step.step}</span>
        <h3 class="text-lg font-semibold text-izza-ink mb-2">{step.title}</h3>
        <p class="text-sm text-izza-gray-muted">{step.description}</p>
      </div>
    ))}
  </div>
</section>
