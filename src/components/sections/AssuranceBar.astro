---
import type { Locale } from '../../i18n/config';
import { getContent } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home } = getContent(locale);
---

<section class="bg-izza-cream border-y border-izza-border/30">
  <div class="container-site py-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {home.assurances.map((item) => (
      <div class="flex gap-4 items-start">
        <img src={item.icon} alt="" class="w-6 h-6 mt-1 opacity-70" />
        <div>
          <strong class="block text-izza-ink font-semibold text-sm mb-1">{item.title}</strong>
          <span class="text-sm text-izza-gray-muted">{item.description}</span>
        </div>
      </div>
    ))}
  </div>
</section>
